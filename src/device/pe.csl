// Local inclusive scan followed by an eastbound carry chain.
param memcpy_params;
param width: i16;
param chunk_size: i16;
param pe_id: i16;
param east_color: color;
param west_color: color;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
// The memcpy runtime reserves queues 0 and 1. Input/output queues are
// distinct resources; each PE keeps queue 2 bound to one color for its life.
const carry_iq = @get_input_queue(2);
const carry_oq = @get_output_queue(2);
const exit_id = @get_local_task_id(9);
const apply_id = @get_local_task_id(10);

var values: [chunk_size]i32;
var valid_count = @zeros([1]i32);
var incoming_carry = @zeros([1]i32);
var local_total = @zeros([1]i32);
var outgoing_carry = @zeros([1]i32);
var completed = @zeros([1]i32);

var values_ptr: [*]i32 = &values;
var valid_count_ptr: [*]i32 = &valid_count;
var incoming_ptr: [*]i32 = &incoming_carry;
var local_total_ptr: [*]i32 = &local_total;
var outgoing_ptr: [*]i32 = &outgoing_carry;
var completed_ptr: [*]i32 = &completed;

const incoming_mem = @get_dsd(mem1d_dsd, .{
  .base_address = &incoming_carry,
  .extent = 1,
});
const outgoing_mem = @get_dsd(mem1d_dsd, .{
  .base_address = &outgoing_carry,
  .extent = 1,
});

fn forward_or_finish() void {
  if (pe_id < width - 1) {
    const east = @get_dsd(fabout_dsd, if (@is_arch("wse3")) .{
      .extent = 1, .output_queue = carry_oq,
    } else .{
      .fabric_color = east_color, .extent = 1, .output_queue = carry_oq,
    });
    // Completion means the memory-to-output-queue operation is complete,
    // not a hardware-wide barrier. The final PE still must consume the chain.
    @mov32(east, outgoing_mem, .{ .async = true, .activate = exit_id });
  } else {
    @activate(exit_id);
  }
}

fn apply_and_forward() void {
  // Host precondition: 0 <= valid_count <= chunk_size. All serial/local
  // prefixes and carry-corrected results were range-checked by the C++ oracle.
  const count = @as(i16, valid_count[0]);
  for (@range(i16, count)) |i| {
    values[i] += incoming_carry[0];
  }
  // An empty PE contributes zero and forwards exactly its incoming carry.
  outgoing_carry[0] = incoming_carry[0] + local_total[0];
  forward_or_finish();
}

fn compute() void {
  // Reset all per-launch state. The host replaces values and valid_count
  // before every launch; padding is never scanned or modified.
  completed[0] = 0;
  incoming_carry[0] = 0;
  local_total[0] = 0;
  outgoing_carry[0] = 0;

  const count = @as(i16, valid_count[0]);
  for (@range(i16, count)) |i| {
    local_total[0] += values[i];
    values[i] = local_total[0];
  }

  if (pe_id == 0) {
    apply_and_forward();
  } else {
    const west = @get_dsd(fabin_dsd, .{
      .extent = 1, .input_queue = carry_iq,
    });
    @mov32(incoming_mem, west, .{ .async = true, .activate = apply_id });
  }
}

task apply_carry() void {
  apply_and_forward();
}

task finish() void {
  completed[0] = 1;
  sys_mod.unblock_cmd_stream();
}

comptime {
  @bind_local_task(apply_carry, apply_id);
  @bind_local_task(finish, exit_id);
  if (pe_id > 0) {
    // SDK 2.10 removed automatic input queue initialization.
    @initialize_queue(carry_iq, .{ .color = west_color });
  }
  if (pe_id < width - 1) {
    @initialize_queue(carry_oq, if (@is_arch("wse3")) .{
      .color = east_color,
    } else .{});
  }
  @export_symbol(values_ptr, "values");
  @export_symbol(valid_count_ptr, "valid_count");
  @export_symbol(incoming_ptr, "incoming_carry");
  @export_symbol(local_total_ptr, "local_total");
  @export_symbol(outgoing_ptr, "outgoing_carry");
  @export_symbol(completed_ptr, "completed");
  @export_symbol(compute);
}
